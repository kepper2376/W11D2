#lang racket
(require "util.rkt")

; A function's private return slot is tagged, like all other scope values.
(define has_returned
  (lambda ()
    (let ((ret (resolve_env environment '|#return|)))
      (and (not (void? ret))
           (not (equal? ret (list 'pending '|#none|)))))))

(define bool-value (lambda (v) (check_type 'bool v)))
(define printable-value
  (lambda (v)
    (case (car v)
      ((bool) (if (cadr v) "True" "False"))
      ((void) "void")
      (else (cadr v)))))

(define process
  (lambda (parsed-exp)
    (cond
      ((void? parsed-exp) void-value)
      ((null? parsed-exp) void-value)
      ((eq? 'var-exp (car parsed-exp))
       (let ((value (resolve_env environment (cadr parsed-exp))))
         (if (void? value) (error "Undefined variable" (cadr parsed-exp)) value)))
      ((eq? 'num-exp (car parsed-exp)) (cadr parsed-exp))
      ((eq? 'string-exp (car parsed-exp)) (cadr parsed-exp))
      ((eq? 'assign-exp (car parsed-exp))
       (wolf_env environment (cadr (car (cadr parsed-exp))) (process (cadr (cadr parsed-exp)))))
      ((eq? 'math-exp (car parsed-exp))
       (do_math (cadr parsed-exp) (process (caddr parsed-exp)) (process (cadddr parsed-exp))))
      ((eq? 'boolean-exp (car parsed-exp))
       (cond
         ((eq? (cadr parsed-exp) 'True) (list 'bool #t))
         ((eq? (cadr parsed-exp) 'False) (list 'bool #f))
         ((eq? (cadr parsed-exp) '!) (list 'bool (not (bool-value (process (caddr parsed-exp))))))
         (else (calculate_boolean (cadr parsed-exp)
                                  (process (caddr parsed-exp))
                                  (process (cadddr parsed-exp))))))
      ((eq? 'ask-exp (car parsed-exp))
       (if (bool-value (process (cadr parsed-exp)))
           (process (caddr parsed-exp))
           (process (cadddr parsed-exp))))
      ((eq? 'list-exp (car parsed-exp))
       (let loop ((statements (cdr parsed-exp)) (last void-value))
         (if (or (null? statements) (has_returned))
             last
             (loop (cdr statements) (process (car statements))))))
      ((eq? 'while-exp (car parsed-exp))
       (let loop ()
         (if (and (not (has_returned)) (bool-value (process (cadr parsed-exp))))
             (begin (push_scope_to_environment '())
                    (process (caddr parsed-exp))
                    (pop_scope_from_environment)
                    (loop))
             void-value)))
      ((eq? 'do-while-exp (car parsed-exp))
       (let loop ()
         (push_scope_to_environment '())
         (process (cadr parsed-exp))
         (pop_scope_from_environment)
         (if (and (not (has_returned)) (bool-value (process (caddr parsed-exp))))
             (loop)
             void-value)))
      ((eq? 'for-exp (car parsed-exp))
       (begin
         (push_scope_to_environment '())
         (process (cadr parsed-exp))
         (let loop ()
           (when (and (not (has_returned))
                      (bool-value (process (caddr parsed-exp))))
             (process (list-ref parsed-exp 4)) ; body
             (unless (has_returned)
               (process (cadddr parsed-exp)) ; step
               (loop))))
         (pop_scope_from_environment)
         void-value))
      ((eq? 'new-func-exp (car parsed-exp)) (list 'func parsed-exp))
      ((eq? 'call-exp (car parsed-exp))
       (let* ((name (cadr (cadr parsed-exp)))
              (func (check_type 'func (resolve_env environment name)))
              (params (cadr func))
              (args (caddr parsed-exp)))
         (unless (= (length params) (length args))
           (error "Wrong number of function arguments" name))
         ; Evaluate arguments in the calling environment, before introducing locals.
         (let* ((values (map process args))
                (new_scope (map (lambda (p v) (list (cadr p) v)) params values)))
           (push_scope_to_environment (cons (list '|#return| (list 'pending '|#none|)) new_scope))
           (process (caddr func))
           (let ((ret (resolve (car environment) '|#return|)))
             (pop_scope_from_environment)
             (if (equal? ret (list 'pending '|#none|)) void-value ret)))))
      ((eq? 'func-exp (car parsed-exp))
       ; Retain support for the older anonymous-function expression form.
       (let* ((pairs (cadr parsed-exp))
              (locals (map (lambda (p) (list (cadr (car p)) (process (cadr p)))) pairs)))
         (push_scope_to_environment (cons (list '|#return| (list 'pending '|#none|)) locals))
         (process (caddr parsed-exp))
         (let ((ret (resolve (car environment) '|#return|)))
           (pop_scope_from_environment)
           (if (equal? ret (list 'pending '|#none|)) void-value ret))))
      ((eq? 'return-exp (car parsed-exp))
       (let ((value (process (cadr parsed-exp))))
         (wolf_env environment '|#return| value)))
      ((eq? 'fire-exp (car parsed-exp))
       (let ((value (process (cadr parsed-exp))))
         (displayln (printable-value value))
         value))
      (else (error "Unsupported expression" parsed-exp)))))

(provide (all-defined-out))
